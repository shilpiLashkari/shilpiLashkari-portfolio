    "start": "node server/server.js"
  },
  "dependencies": {
    "concurrently": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "nodemon": "^3.0.0"
  }
}